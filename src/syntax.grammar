@skip { space | Comment }

Tape_symbol { '0' | '1' | "_" | Var_name }

Head_move { "L"|"R"|"S" }

Function { Fun_name "(" (digit | Var_name) ")" }

Fun_sequence { Function | "[]" | "[" Function ("," Function)* "]" }

Tape_action { "(" Tape_symbol "," Head_move ")" | Fun_sequence }

State_rule { "|" Tape_symbol "->" Tape_action "," Sname }

State { Sname State_rule+ }

@top File { State* }

@tokens {
  space { $[ \t\n\r]+ }
  digit { $[1-9] }
  // We accept Sname that are alphanumeric characters or an emoji
  Sname { $[a-zA-Z_] $[a-zA-Z1-9_]* | $[\u{203C}-\u{3299}] | $[\u{1F004}-\u{1FAF8}] }
  Fun_name { $[A-Z] $[A-Z1-9_]* }
  Var_name { $[a-zA-Z] $[a-zA-Z1-9]* }
  Comment { "//" ![\n]* }
}


@detectDelim
